{%- comment -%}
  Shared render for bundle upsell banner.
  Called by:
    - sections/bb-cart-upsell-bundle.liquid  (standalone section, uses section.settings)
    - sections/main-cart.liquid block loop   (inline block, passes block object)
  Expects: block (Shopify block object with .id and .settings)
{%- endcomment -%}

{%- assign bb_buckle = block.settings.buckle_key | default: 'buckle-1' -%}
{%- assign bb_strap  = block.settings.strap_key  | default: 'strap-nero' -%}
{%- assign bb_length = block.settings.belt_length | default: '130' -%}
{%- assign bb_title  = block.settings.title       | default: 'Aggiungi una cintura' -%}
{%- assign bb_btn    = block.settings.button_label | default: '+ Aggiungi' -%}
{%- assign bb_uid    = block.id -%}

<style>
  #bb-upsell-blk-{{ bb_uid }} .bb-cart-upsell__action {
    border: none;
    cursor: pointer;
    font-weight: 700;
    font-size: 14px;
    font-family: inherit;
    line-height: 1;
  }
  #bb-upsell-blk-{{ bb_uid }} .bb-cart-upsell__action:disabled {
    opacity: .6;
    cursor: not-allowed;
  }
  #bb-upsell-blk-{{ bb_uid }} .bb-upsell-img {
    width: 50px;
    height: 50px;
    object-fit: cover;
    border-radius: 8px;
    flex-shrink: 0;
    background: #2a2a2a;
    transition: opacity .25s;
  }
</style>

<div
  id="bb-upsell-blk-{{ bb_uid }}"
  class="bb-cart-upsell-wrap"
  data-buckle="{{ bb_buckle }}"
  data-strap="{{ bb_strap }}"
  data-length="{{ bb_length }}"
  data-label="{{ bb_btn | escape }}"
  data-media-url="{{ 'bundle-builder-media.json' | asset_url }}"
  data-catalog-url="{{ 'bundle-builder-catalog.json' | asset_url }}"
  {{ block.shopify_attributes }}
>
  <div class="bb-cart-upsell__card">
    <img
      id="bb-upsell-img-{{ bb_uid }}"
      src="{{ 'blank.svg' | asset_url }}"
      alt="{{ bb_title }}"
      class="bb-upsell-img"
      loading="lazy"
      width="50"
      height="50"
    >
    <div class="bb-cart-upsell__right">
      <strong class="bb-cart-upsell__title">{{ bb_title }}</strong>
      <div class="bb-cart-upsell__prices">
        <span class="bb-cart-upsell__new-price" id="bb-upsell-price-{{ bb_uid }}"></span>
        {%- if block.settings.compare_price != blank -%}
          <span class="bb-cart-upsell__old-price" id="bb-upsell-compare-{{ bb_uid }}" style="display:none;">€{{ block.settings.compare_price }}</span>
        {%- endif -%}
      </div>
      <button
        class="bb-cart-upsell__action"
        id="bb-upsell-btn-{{ bb_uid }}"
        data-label="{{ bb_btn | escape }}"
        disabled
      >{{ bb_btn }}</button>
    </div>
  </div>
</div>

<script>
(function () {
  var root = document.getElementById('bb-upsell-blk-{{ bb_uid }}');
  var img  = document.getElementById('bb-upsell-img-{{ bb_uid }}');
  var priceEl = document.getElementById('bb-upsell-price-{{ bb_uid }}');
  var btn  = document.getElementById('bb-upsell-btn-{{ bb_uid }}');
  if (!root || !btn) return;

  var buckleKey  = root.dataset.buckle;
  var strapKey   = root.dataset.strap;
  var beltLength = root.dataset.length;
  var btnLabel   = root.dataset.label;
  var mediaUrl   = root.dataset.mediaUrl;
  var catalogUrl = root.dataset.catalogUrl;

  var STRAP_NAMES = {
    'strap-nero':'Black','strap-marrone':'Brown','strap-cognac':'Cognac',
    'strap-cuoio':'White','strap-beige':'Sand','strap-rosso':'Brown Crocodile',
    'strap-verde':'Black Crocodile','strap-blu':'Blue','strap-grigio':'Gray'
  };
  var BUCKLE_NAMES = {
    'buckle-1':'Classic Matt','buckle-2':'Elegant Chrome Silver',
    'buckle-3':'Elegant Chrome Gold','buckle-4':'Mirror Chrome'
  };
  var BUCKLE_CATALOG = {
    'buckle-1':'FIBBIA-CLASSIC','buckle-2':'FIBBIA-SILVER',
    'buckle-3':'FIBBIA-GOLD','buckle-4':'FIBBIA-LUXURY'
  };
  var TIER_PRICES = ['49,99','39,99','34,99','29,99'];

  var catalog = null, media = null;

  function countCartBelts(items) {
    var n = 0;
    items.forEach(function(item) {
      Object.keys(item.properties || {}).forEach(function(k) {
        if (/^Cintura \d+ - Pelle$/.test(k)) n++;
      });
    });
    return n;
  }

  function syncImage() {
    if (!media) return;
    var key = strapKey + '__' + beltLength + '__' + buckleKey;
    var combo = media.combinations && media.combinations[key];
    var url = (combo && combo.photo)
      || (media.straps && media.straps[strapKey] && (media.straps[strapKey][beltLength] || media.straps[strapKey]['130']))
      || (media.buckles && media.buckles[buckleKey]);
    if (url && img) {
      img.style.opacity = '0';
      var tmp = new Image();
      tmp.onload = function() { img.src = url; img.style.opacity = '1'; };
      tmp.src = url;
    }
  }

  function addToCart() {
    var bundleId = Date.now().toString(36) + Math.random().toString(36).slice(2,6);
    var key = strapKey + '__' + beltLength + '__' + buckleKey;
    var combo = media && media.combinations && media.combinations[key];
    var strapCatalogKey  = 'STRAP-' + strapKey.replace('strap-','').toUpperCase() + '-' + beltLength;
    var buckleCatalogKey = BUCKLE_CATALOG[buckleKey];
    var props = { _bundle_id: bundleId };
    props['Cintura 1 - Pelle']     = STRAP_NAMES[strapKey]  || strapKey;
    props['Cintura 1 - Lunghezza'] = beltLength + 'cm';
    props['Cintura 1 - Fibbia']    = BUCKLE_NAMES[buckleKey] || buckleKey;
    if (combo && combo.photo) props['_cintura_1_img'] = combo.photo;
    var sv = Number(catalog[strapCatalogKey]);
    var bv = Number(catalog[buckleCatalogKey]);
    if (sv > 0) props['_cintura_1_strap_vid']  = String(sv);
    if (bv > 0) props['_cintura_1_buckle_vid'] = String(bv);
    var setVid = Number(catalog['SET-CINTURA-SINGOLA']);
    if (!setVid) { btn.disabled = false; btn.textContent = btnLabel; return; }
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: [{ id: setVid, quantity: 1, properties: props }] })
    })
    .then(function(r) { if (!r.ok) throw new Error(r.status); return r.json(); })
    .then(function() { window.location.href = '/cart'; })
    .catch(function() { btn.disabled = false; btn.textContent = btnLabel; });
  }

  Promise.all([
    fetch(mediaUrl).then(function(r) { return r.json(); }),
    fetch(catalogUrl).then(function(r) { return r.json(); }),
    fetch('/cart.js').then(function(r) { return r.json(); })
  ]).then(function(res) {
    media   = res[0];
    catalog = res[1];
    var beltCount = countCartBelts(res[2].items);
    syncImage();
    if (priceEl) priceEl.textContent = '€' + (TIER_PRICES[Math.min(beltCount, 3)] || '29,99');
    var compareEl = document.getElementById('bb-upsell-compare-{{ bb_uid }}');
    if (compareEl) compareEl.style.display = beltCount > 0 ? '' : 'none';
    btn.disabled = false;
  }).catch(function() { btn.disabled = false; });

  btn.addEventListener('click', function() {
    btn.disabled = true;
    btn.textContent = '…';
    addToCart();
  });
})();
</script>
