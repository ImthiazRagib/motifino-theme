{%- if section.settings.enabled != false -%}

{%- assign vis_count = 0 -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'slide' and block.settings.enabled != false -%}
    {%- assign vis_count = vis_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

{%- if vis_count > 0 -%}
  {%- assign speed_ms = section.settings.autoplay_speed | times: 1000 -%}
  {%- assign _pt = section.settings.padding_top    | default: 0 -%}
  {%- assign _pb = section.settings.padding_bottom | default: 0 -%}
  {%- assign _pl = section.settings.padding_left   | default: 0 -%}
  {%- assign _pr = section.settings.padding_right  | default: 0 -%}
  {%- assign _mt = section.settings.margin_top     | default: 0 -%}
  {%- assign _mb = section.settings.margin_bottom  | default: 0 -%}

  <div
    class="bb-upsell-carousel"
    id="bb-upsell-carousel-{{ section.id }}"
    data-speed="{{ speed_ms }}"
    data-arrows="{{ section.settings.show_arrows }}"
    style="padding:{{ _pt }}px {{ _pr }}px {{ _pb }}px {{ _pl }}px;margin-top:{{ _mt }}px;margin-bottom:{{ _mb }}px;"
  >
    <div class="bb-upsell-carousel__track-wrap">
      <div class="bb-upsell-carousel__track" id="bb-upsell-track-{{ section.id }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'slide' and block.settings.enabled != false -%}
            <div class="bb-upsell-carousel__slide" {{ block.shopify_attributes }}>
              {%- render 'bb-cart-upsell-block', block: block -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- if vis_count > 1 -%}
    <div class="bb-upsell-carousel__footer">
      {%- if section.settings.show_arrows -%}
        <button class="bb-upsell-carousel__btn" id="bb-upsell-prev-{{ section.id }}" aria-label="Previous">&#8592;</button>
      {%- endif -%}
      <div class="bb-upsell-carousel__dots" id="bb-upsell-dots-{{ section.id }}">
        {%- for i in (1..vis_count) -%}
          <span class="bb-upsell-carousel__dot{% if forloop.first %} is-active{% endif %}"></span>
        {%- endfor -%}
      </div>
      {%- if section.settings.show_arrows -%}
        <button class="bb-upsell-carousel__btn" id="bb-upsell-next-{{ section.id }}" aria-label="Next">&#8594;</button>
      {%- endif -%}
    </div>
    {%- endif -%}
  </div>

  <script>
  (function () {
    var root    = document.getElementById('bb-upsell-carousel-{{ section.id }}');
    var track   = document.getElementById('bb-upsell-track-{{ section.id }}');
    var dotsEl  = document.getElementById('bb-upsell-dots-{{ section.id }}');
    var prevBtn = document.getElementById('bb-upsell-prev-{{ section.id }}');
    var nextBtn = document.getElementById('bb-upsell-next-{{ section.id }}');
    if (!track) return;

    var dots    = dotsEl ? dotsEl.querySelectorAll('.bb-upsell-carousel__dot') : [];
    var total   = track.querySelectorAll('.bb-upsell-carousel__slide').length;
    var current = 0;
    var speed   = Number(root.dataset.speed) || 4000;
    var timer   = null;

    function goTo(idx) {
      current = ((idx % total) + total) % total;
      track.style.transform = 'translateX(-' + (current * 100) + '%)';
      dots.forEach(function (d, i) { d.classList.toggle('is-active', i === current); });
    }

    function stopLoop()  { clearInterval(timer); timer = null; }
    function startLoop() {
      stopLoop();
      if (total < 2) return;
      timer = setInterval(function () { goTo(current + 1); }, speed);
    }

    if (prevBtn) prevBtn.addEventListener('click', function () { stopLoop(); goTo(current - 1); startLoop(); });
    if (nextBtn) nextBtn.addEventListener('click', function () { stopLoop(); goTo(current + 1); startLoop(); });

    dots.forEach(function (d, i) {
      d.addEventListener('click', function () { stopLoop(); goTo(i); startLoop(); });
    });

    root.addEventListener('mouseenter', stopLoop);
    root.addEventListener('mouseleave', startLoop);

    var sx = 0;
    track.addEventListener('touchstart', function (e) { stopLoop(); sx = e.touches[0].clientX; }, { passive: true });
    track.addEventListener('touchend',   function (e) {
      var dx = e.changedTouches[0].clientX - sx;
      if (dx < -40) goTo(current + 1);
      else if (dx > 40) goTo(current - 1);
      startLoop();
    }, { passive: true });

    startLoop();
  })();
  </script>
{%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Bundle Upsell Carousel",
  "tag": "div",
  "class": "bb-upsell-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show carousel",
      "default": true
    },
    {
      "type": "header",
      "content": "Carousel Settings"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed (seconds)",
      "min": 2,
      "max": 15,
      "step": 1,
      "default": 4,
      "unit": "s"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show prev / next arrows",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0, "max": 80, "step": 2, "unit": "px", "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0, "max": 80, "step": 2, "unit": "px", "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0, "max": 60, "step": 2, "unit": "px", "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0, "max": 60, "step": 2, "unit": "px", "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Padding left",
      "min": 0, "max": 60, "step": 2, "unit": "px", "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Padding right",
      "min": 0, "max": 60, "step": 2, "unit": "px", "default": 0
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Bundle Banner",
      "settings": [
        {
          "type": "checkbox",
          "id": "enabled",
          "label": "Show this slide",
          "default": true
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Aggiungi una cintura"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare-at price (crossed out)",
          "default": "49,99"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "+ Aggiungi"
        },
        {
          "type": "header",
          "content": "Belt Combination"
        },
        {
          "type": "select",
          "id": "buckle_key",
          "label": "Fibbia (Buckle)",
          "options": [
            { "value": "buckle-1", "label": "Classic Matt" },
            { "value": "buckle-2", "label": "Elegant Chrome Silver" },
            { "value": "buckle-3", "label": "Elegant Chrome Gold" },
            { "value": "buckle-4", "label": "Mirror Chrome" }
          ],
          "default": "buckle-1"
        },
        {
          "type": "select",
          "id": "strap_key",
          "label": "Pelle (Strap colour)",
          "options": [
            { "value": "strap-nero",    "label": "Black" },
            { "value": "strap-marrone", "label": "Brown" },
            { "value": "strap-cognac",  "label": "Cognac" },
            { "value": "strap-cuoio",   "label": "White" },
            { "value": "strap-beige",   "label": "Sand" },
            { "value": "strap-rosso",   "label": "Brown Crocodile" },
            { "value": "strap-verde",   "label": "Black Crocodile" },
            { "value": "strap-blu",     "label": "Blue" },
            { "value": "strap-grigio",  "label": "Gray" }
          ],
          "default": "strap-nero"
        },
        {
          "type": "select",
          "id": "belt_length",
          "label": "Lunghezza (Length)",
          "options": [
            { "value": "130", "label": "130 cm" },
            { "value": "150", "label": "150 cm" }
          ],
          "default": "130"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle Upsell Carousel",
      "blocks": [
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
