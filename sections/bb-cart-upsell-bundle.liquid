{%- if section.settings.enabled != false -%}
  {%- render 'bb-cart-upsell-block', block: section -%}
{%- endif -%}

{% schema %}
{
  "name": "Bundle Upsell Banner",
  "tag": "div",
  "class": "bb-upsell-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show banner",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Aggiungi una cintura"
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "Compare-at price (crossed out)",
      "default": "49,99",
      "info": "e.g. 49,99 — shown as red strikethrough"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "+ Aggiungi"
    },
    {
      "type": "header",
      "content": "Belt Combination"
    },
    {
      "type": "select",
      "id": "buckle_key",
      "label": "Fibbia (Buckle)",
      "options": [
        { "value": "buckle-1", "label": "Classic Matt" },
        { "value": "buckle-2", "label": "Elegant Chrome Silver" },
        { "value": "buckle-3", "label": "Elegant Chrome Gold" },
        { "value": "buckle-4", "label": "Mirror Chrome" }
      ],
      "default": "buckle-1"
    },
    {
      "type": "select",
      "id": "strap_key",
      "label": "Pelle (Strap colour)",
      "options": [
        { "value": "strap-nero",    "label": "Black" },
        { "value": "strap-marrone", "label": "Brown" },
        { "value": "strap-cognac",  "label": "Cognac" },
        { "value": "strap-cuoio",   "label": "White" },
        { "value": "strap-beige",   "label": "Sand" },
        { "value": "strap-rosso",   "label": "Brown Crocodile" },
        { "value": "strap-verde",   "label": "Black Crocodile" },
        { "value": "strap-blu",     "label": "Blue" },
        { "value": "strap-grigio",  "label": "Gray" }
      ],
      "default": "strap-nero"
    },
    {
      "type": "select",
      "id": "belt_length",
      "label": "Lunghezza (Length)",
      "options": [
        { "value": "130", "label": "130 cm" },
        { "value": "150", "label": "150 cm" }
      ],
      "default": "130"
    }
  ],
  "presets": [
    {
      "name": "Bundle Upsell Banner"
    }
  ]
}
{% endschema %}
