{%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient
  | default: section.settings.color_scheme.settings.background
  | md5
-%}

{%- if section.settings.use_custom_section_spacing -%}
  <style>
    #shopify-section-{{ section.id }} .section-spacing.section-spacing--custom-bbox {
      padding-block-start: var(--main-cart-bbox-pt);
      padding-inline-end: var(--main-cart-bbox-pr);
      padding-block-end: var(--main-cart-bbox-pb);
      padding-inline-start: var(--main-cart-bbox-pl);
    }

    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} .section-spacing.section-spacing--custom-bbox {
        padding-block-start: var(--main-cart-bbox-pt-d);
        padding-inline-end: var(--main-cart-bbox-pr-d);
        padding-block-end: var(--main-cart-bbox-pb-d);
        padding-inline-start: var(--main-cart-bbox-pl-d);
      }
    }

    #shopify-section-{{ section.id }} .section-spacing.section-spacing--custom-bbox .container {
      margin-inline-start: max(0px, 50% - var(--container-max-width) / 2);
      margin-inline-end: max(0px, 50% - var(--container-max-width) / 2);
    }
  </style>
{%- endif -%}

<div
  class="section-spacing{% if section.settings.use_custom_section_spacing %} section-spacing--custom-bbox{% else %} section-spacing--tight{% endif %} color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }}"
  {% if section.settings.use_custom_section_spacing %}
    style="--main-cart-bbox-pt: {{ section.settings.mobile_section_spacing_top | default: 0 }}px; --main-cart-bbox-pr: {{ section.settings.mobile_section_spacing_right | default: 0 }}px; --main-cart-bbox-pb: {{ section.settings.mobile_section_spacing_bottom | default: 0 }}px; --main-cart-bbox-pl: {{ section.settings.mobile_section_spacing_left | default: 0 }}px; --main-cart-bbox-pt-d: {{ section.settings.desktop_section_spacing_top | default: 0 }}px; --main-cart-bbox-pr-d: {{ section.settings.desktop_section_spacing_right | default: 0 }}px; --main-cart-bbox-pb-d: {{ section.settings.desktop_section_spacing_bottom | default: 0 }}px; --main-cart-bbox-pl-d: {{ section.settings.desktop_section_spacing_left | default: 0 }}px;"
  {% endif %}
>
  {%- if cart.empty? -%}
    <div class="container container--xs">
      <div class="empty-state">
        <div class="prose">
          <h1 class="h4">{{ 'cart.general.title' | t }}</h1>
          <p>{{ 'cart.general.empty' | t }}</p>

          {%- assign button_content = 'cart.general.continue_shopping' | t -%}
          {%- render 'button', content: button_content, href: settings.cart_empty_cart_link -%}
        </div>
      </div>
    </div>
  {%- else -%}
    <div class="container container--sm">
      <div class="section-stack">
        <div class="section-header justify-self-center text-center">
          <div class="v-stack gap-1">
            <h1 class="h2">{{ 'cart.general.title' | t }}</h1>

            {%- if settings.cart_show_free_shipping_bar -%}
              {%- render 'free-shipping-bar' -%}
            {%- endif -%}
          </div>
        </div>

        {%- assign _cart_belt_count = 0 -%}
        {%- for _ci in cart.items -%}
          {%- for _p in _ci.properties -%}
            {%- if _p.first contains 'Cintura ' and _p.first contains ' - Pelle' -%}
              {%- assign _cart_belt_count = _cart_belt_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
        {%- if _cart_belt_count == 0 -%}
          {%- assign _next_belt_price = '49,99' -%}
        {%- elsif _cart_belt_count == 1 -%}
          {%- assign _next_belt_price = '39,99' -%}
        {%- elsif _cart_belt_count == 2 -%}
          {%- assign _next_belt_price = '34,99' -%}
        {%- else -%}
          {%- assign _next_belt_price = '29,99' -%}
        {%- endif -%}
        {%- assign _next_belt_num = _cart_belt_count | plus: 1 -%}
        <a href="/pages/bundle?type=set-cintura-singola" class="bb-cart-upsell__card">
          <img
            src="https://cdn.shopify.com/s/files/1/0677/2083/9299/files/single_set_1.jpg?v=1776238594"
            alt="Cintura"
            class="bb-cart-upsell__img"
            loading="lazy"
          >
          <div class="bb-cart-upsell__info">
            <strong class="bb-cart-upsell__title">Crea la tua {{ _next_belt_num }}° Cintura</strong>
            <div class="bb-cart-upsell__prices">
              <span class="bb-cart-upsell__new-price">€{{ _next_belt_price }}</span>
              {%- if _cart_belt_count > 0 -%}
                <span class="bb-cart-upsell__old-price">€49,99</span>
              {%- endif -%}
            </div>
          </div>
          <span class="bb-cart-upsell__action">+ Aggiungi</span>
        </a>

        <form action="{{ routes.cart_url }}" method="POST" class="cart-page">
          <input type="hidden" name="attributes[products_mobile_grid_mode]" value="">
          <input type="hidden" name="attributes[products_desktop_grid_mode]" value="">

          <div class="v-stack gap-6">
            {%- comment -%}
              ----------------------------------------------------------------------------------------------------------------
              ORDER SUMMARY
              ----------------------------------------------------------------------------------------------------------------
            {%- endcomment -%}
            <table class="order-summary table--reduce-border">
              <thead class="order-summary__header">
                <tr>
                  <th>{{ 'cart.order.product' | t }}</th>
                  <th class="text-end">{{ 'cart.order.total' | t }}</th>
                </tr>
              </thead>

              <tbody class="order-summary__body">
                {%- assign _extra_belt_unit_price = 0 -%}
                {%- assign _nfc_belt_unit_price = 0 -%}
                {%- for _item in cart.items -%}
                  {%- for _p in _item.properties -%}
                    {%- if _p.first == '_bundle_extra' -%}
                      {%- assign _extra_belt_unit_price = _item.final_price -%}
                    {%- endif -%}
                    {%- if _p.first == '_bundle_nfc' -%}
                      {%- assign _nfc_belt_unit_price = _item.final_price -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endfor -%}
                {%- assign _total_bundles = 0 -%}
                {%- for _ci2 in cart.items -%}
                  {%- for _p in _ci2.properties -%}
                    {%- if _p.first contains 'Cintura ' and _p.first contains ' - Pelle' -%}
                      {%- assign _total_bundles = _total_bundles | plus: 1 -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endfor -%}
                {%- assign _global_belt_num = _total_bundles | plus: 1 -%}
                {%- for line_item in cart.items -%}
                  {%- assign _is_bundle_extra = false -%}
                  {%- for _p in line_item.properties -%}
                    {%- if _p.first == '_bundle_extra' -%}
                      {%- assign _is_bundle_extra = true -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                  {% comment %} Hidden Rows {% endcomment %}
                  {%- if _is_bundle_extra -%}{%- continue -%}{%- endif -%}
                  {%- if line_item.properties._bundle_nfc == '1' -%}{%- continue -%}{%- endif -%}
                  {%- if line_item.properties._bundle_component == '1' -%}{%- continue -%}{%- endif -%}
                  {%- if line_item.properties._bundle_privileged == '1' -%}{%- continue -%}{%- endif -%}
                  {%- assign _is_main_bundle = false -%}
                  {%- for _p in line_item.properties -%}
                    {%- if _p.first contains 'Cintura ' -%}
                      {%- assign _is_main_bundle = true -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                  {%- assign _row_belt_count = 0 -%}
                  {%- assign _row_extra_per_unit = 0 -%}
                  {%- assign _row_nfc_per_unit = 0 -%}
                  {%- if _is_main_bundle -%}
                    {%- for _p in line_item.properties -%}
                      {%- assign _pk = _p.first | strip -%}
                      {%- if _pk contains 'Cintura ' and _pk contains ' - Pelle' -%}
                        {%- assign _row_belt_count = _row_belt_count | plus: 1 -%}
                      {%- endif -%}
                    {%- endfor -%}
                    {%- if _row_belt_count > 4 and _extra_belt_unit_price > 0 -%}
                      {%- assign _row_extra_belts = _row_belt_count | minus: 4 -%}
                      {%- assign _row_extra_per_unit = _extra_belt_unit_price | times: _row_extra_belts -%}
                    {%- endif -%}
                    {%- if _nfc_belt_unit_price > 0 -%}
                      {%- assign _row_nfc_per_unit = _nfc_belt_unit_price | times: _row_belt_count -%}
                    {%- endif -%}
                  {%- endif -%}

                  {%- assign hide_quantity = false -%}
                  {%- if settings.hide_qty_keywords != blank -%}
                    {%- assign keywords = settings.hide_qty_keywords | split: ',' -%}
                    {%- assign downcase_title = line_item.product.title | default: line_item.title | downcase -%}
                    {%- for keyword in keywords -%}
                      {%- assign clean_keyword = keyword | strip | downcase -%}
                      {%- if clean_keyword != blank and downcase_title contains clean_keyword -%}
                        {%- assign hide_quantity = true -%}
                        {%- break -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}

                  {%- if _is_main_bundle and _row_belt_count > 1 -%}
                    {%- comment -%} Multi-belt bundle: one row per belt {%- endcomment -%}
                    {%- for _bi in (1.._row_belt_count) -%}
                      {%- assign _global_belt_num = _global_belt_num | minus: 1 -%}
                      {%- assign _belt_label = 'Cintura ' | append: _global_belt_num -%}
                      {%- assign _li_belt_price_pos = _global_belt_num | minus: 1 -%}
                      {%- assign _local_belt_n = _row_belt_count | minus: _bi | plus: 1 -%}
                      {%- if _li_belt_price_pos == 0 -%}
                        {%- assign _li_belt_price_cents = 4999 -%}
                      {%- elsif _li_belt_price_pos == 1 -%}
                        {%- assign _li_belt_price_cents = 3999 -%}
                      {%- elsif _li_belt_price_pos == 2 -%}
                        {%- assign _li_belt_price_cents = 3499 -%}
                      {%- else -%}
                        {%- assign _li_belt_price_cents = 2999 -%}
                      {%- endif -%}
                      <tr>
                        <td>
                          {%- render 'line-item',
                            line_item: line_item,
                            show_quantity_selector: false,
                            is_main_bundle: true,
                            belt_label: _belt_label,
                            belt_n: _local_belt_n,
                            belt_remove_total: _row_belt_count,
                            belt_price_cents: _li_belt_price_cents,
                            belt_price_pos: _li_belt_price_pos
                          -%}
                        </td>
                        <td class="text-end">
                          {%- assign _display_price = _li_belt_price_cents | times: line_item.quantity -%}
                          {{- _display_price | money -}}
                          {%- if _li_belt_price_pos > 0 -%}
                            <br>
                            <span class="bb-li-original-price">{{- 4999 | times: line_item.quantity | money -}}</span>
                          {%- endif -%}
                        </td>
                      </tr>
                    {%- endfor -%}
                  {%- else -%}
                    {%- comment -%} Single-belt item or non-bundle: one row {%- endcomment -%}
                    {%- if _is_main_bundle -%}
                      {%- assign _global_belt_num = _global_belt_num | minus: 1 -%}
                    {%- endif -%}
                    {%- assign _li_is_belt_item = false -%}
                    {%- if line_item.properties['Cintura 1 - Pelle'] != blank
                      or line_item.properties['Cintura 1 - Lunghezza'] != blank
                    -%}
                      {%- assign _li_is_belt_item = true -%}
                      {%- assign _li_belt_price_pos = _global_belt_num | minus: 1 -%}
                      {%- if _li_belt_price_pos == 0 -%}
                        {%- assign _li_belt_price_cents = 4999 -%}
                      {%- elsif _li_belt_price_pos == 1 -%}
                        {%- assign _li_belt_price_cents = 3999 -%}
                      {%- elsif _li_belt_price_pos == 2 -%}
                        {%- assign _li_belt_price_cents = 3499 -%}
                      {%- else -%}
                        {%- assign _li_belt_price_cents = 2999 -%}
                      {%- endif -%}
                    {%- endif -%}
                    {%- assign _belt_label = '' -%}
                    {%- if _is_main_bundle -%}
                      {%- assign _belt_label = 'Cintura ' | append: _global_belt_num -%}
                    {%- endif -%}
                    <tr>
                      <td>
                        {%- render 'line-item',
                          line_item: line_item,
                          show_quantity_selector: false,
                          extra_bundle_price: _row_extra_per_unit,
                          nfc_bundle_price: _row_nfc_per_unit,
                          is_main_bundle: _is_main_bundle,
                          belt_label: _belt_label,
                          belt_price_cents: _li_belt_price_cents,
                          belt_price_pos: _li_belt_price_pos
                        -%}
                      </td>
                      <td class="text-end">
                        {%- assign _display_price = line_item.final_line_price -%}
                        {%- if _is_main_bundle -%}
                          {%- if _row_extra_per_unit > 0 -%}
                            {%- assign _extra_row_total = _row_extra_per_unit | times: line_item.quantity -%}
                            {%- assign _display_price = _display_price | plus: _extra_row_total -%}
                          {%- endif -%}
                          {%- if _row_nfc_per_unit > 0 -%}
                            {%- assign _nfc_row_total = _row_nfc_per_unit | times: line_item.quantity -%}
                            {%- assign _display_price = _display_price | plus: _nfc_row_total -%}
                          {%- endif -%}
                        {%- endif -%}
                        {%- if _li_is_belt_item -%}
                          {%- assign _display_price = _li_belt_price_cents | times: line_item.quantity -%}
                          {{- _display_price | money -}}
                          {%- if _li_belt_price_pos > 0 -%}
                            <br>
                            <span class="bb-li-original-price">{{- line_item.original_line_price | money -}}</span>
                          {%- endif -%}
                        {%- else -%}
                          {%- if settings.currency_code_enabled -%}
                            {{- _display_price | money_with_currency -}}
                          {%- else -%}
                            {{- _display_price | money -}}
                          {%- endif -%}
                        {%- endif -%}
                      </td>
                    </tr>
                  {%- endif -%}
                {%- endfor -%}
                {%- if _cart_belt_count > 0 -%}
                  {%- assign _nfc_total_value = _cart_belt_count | times: 1999 -%}
                  <tr class="bb-nfc-gift-row">
                    <td>
                      <line-item class="line-item">
                        <img
                          src="https://cdn.shopify.com/s/files/1/0829/7909/4854/files/Privilege_Card_Black_Product.jpg?v=1782396451"
                          alt="Privilege Card Black"
                          width="120"
                          height="120"
                          loading="lazy"
                          class="line-item__media"
                          style="object-fit:cover;"
                        >
                        <div class="line-item-info" style="flex:1;min-width:0;">
                          <div class="v-stack justify-items-start gap-1">
                            <div>
                              <p style="font-weight:700;">Privilege Card Black x{{ _cart_belt_count }}</p>
                            </div>
                            <div class="h-stack gap-2" style="align-items:center;">
                              <span style="color:#2a9d2a;font-weight:600;">GRATIS</span>
                              <span class="bb-li-original-price">{{ _nfc_total_value | money }}</span>
                            </div>
                          </div>
                        </div>
                      </line-item>
                    </td>
                    <td class="text-end" style="vertical-align:middle;">
                      {{ 0 | money_with_currency }}
                    </td>
                  </tr>
                {%- endif -%}
              </tbody>
            </table>

            {%- comment -%}
              ----------------------------------------------------------------------------------------------------------------
              CART FOOTER
              ----------------------------------------------------------------------------------------------------------------
            {%- endcomment -%}
            <div class="cart-footer">
              {%- if section.settings.show_cart_note -%}
                <cart-note class="cart-note">
                  {%- assign order_note = 'cart.general.add_order_note' | t -%}
                  {%- assign placeholder = 'cart.general.note_placeholder' | t -%}
                  {%- render 'input',
                    name: 'note',
                    multiline: 3,
                    label: order_note,
                    value: cart.note,
                    placeholder: placeholder,
                    show_label_as_block: true
                  -%}
                </cart-note>
              {%- endif -%}

              <div class="bb-cart-recap">
                {%- render 'cart-discount' -%}

                {%- assign _bb_belt_full = 0 -%}
                {%- assign _bb_belt_total = 0 -%}
                {%- assign _bb_single_total = 0 -%}
                {%- assign _bb_belt_total_pos = 0 -%}
                {%- for _ti in cart.items -%}
                  {%- assign _ti_skip = false -%}
                  {%- for _p in _ti.properties -%}
                    {%- if _p.first == '_bundle_extra'
                      or _p.first == '_bundle_nfc'
                      or _p.first == '_bundle_component'
                      or _p.first == '_bundle_privileged'
                    -%}
                      {%- assign _ti_skip = true -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                  {%- if _ti_skip -%}{%- continue -%}{%- endif -%}
                  {%- if _ti.properties['Cintura 1 - Pelle'] != blank
                    or _ti.properties['Cintura 1 - Lunghezza'] != blank
                  -%}
                    {%- assign _ti_belt_slots = 0 -%}
                    {%- for _tp in _ti.properties -%}
                      {%- if _tp.first contains 'Cintura ' and _tp.first contains ' - Pelle' -%}
                        {%- assign _ti_belt_slots = _ti_belt_slots | plus: 1 -%}
                      {%- endif -%}
                    {%- endfor -%}
                    {%- for _slot in (1.._ti_belt_slots) -%}
                      {%- assign _bb_belt_full = _bb_belt_full | plus: 4999 -%}
                      {%- if _bb_belt_total_pos == 0 -%}
                        {%- assign _ti_pc = 4999 -%}
                      {%- elsif _bb_belt_total_pos == 1 -%}
                        {%- assign _ti_pc = 3999 -%}
                      {%- elsif _bb_belt_total_pos == 2 -%}
                        {%- assign _ti_pc = 3499 -%}
                      {%- else -%}
                        {%- assign _ti_pc = 2999 -%}
                      {%- endif -%}
                      {%- assign _bb_belt_total_pos = _bb_belt_total_pos | plus: 1 -%}
                      {%- assign _bb_belt_total = _bb_belt_total | plus: _ti_pc -%}
                    {%- endfor -%}
                  {%- else -%}
                    {%- assign _bb_single_total = _bb_single_total | plus: _ti.final_line_price -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- assign _bb_savings = _bb_belt_full | minus: _bb_belt_total -%}
                {%- assign _bb_cart_disc = 0 -%}
                {%- for _da in cart.cart_level_discount_applications -%}
                  {%- assign _bb_cart_disc = _bb_cart_disc | plus: _da.total_allocated_amount -%}
                {%- endfor -%}
                {%- assign _bb_combined = _bb_belt_total | plus: _bb_single_total -%}
                {%- assign _bb_final_total = _bb_combined | minus: _bb_cart_disc -%}

                {%- if _cart_belt_count > 0 -%}
                  {%- assign _bb_importo = _bb_belt_full | plus: _nfc_total_value -%}
                  {%- assign _bb_offerta_total = _bb_savings | plus: _nfc_total_value -%}
                  {%- if _bb_offerta_total > 0 -%}
                    <div class="bb-recap-row">
                      <span>Importo:</span>
                      <span>{{ _bb_importo | money }}</span>
                    </div>
                    <div class="bb-recap-row bb-recap-row--discount" style="border-bottom:none;padding-bottom:0;">
                      <span>Offerta Set:</span>
                      <span>-{{ _bb_offerta_total | money }}</span>
                    </div>
                    {%- assign _shipping_threshold_cents = settings.cart_free_shipping_threshold | times: 100 -%}
                    {%- if cart.total_price >= _shipping_threshold_cents -%}
                      <div class="bb-recap-row" style="padding-bottom:10px;border-bottom:1px solid rgb(var(--border-color));">
                        <span>Spedizione:</span>
                        <span>GRATIS</span>
                      </div>
                    {%- endif -%}
                  {%- endif -%}
                  {%- if _bb_single_total > 0 -%}
                    <div class="bb-recap-row">
                      <span>Prodotti:</span>
                      <span>{{ _bb_single_total | money }}</span>
                    </div>
                  {%- endif -%}
                {%- endif -%}

                {%- if cart.cart_level_discount_applications.size > 0 -%}
                  <div class="bb-recap-coupons">
                    {%- for discount_application in cart.cart_level_discount_applications -%}
                      <span class="discount-badge text-xs">
                        {%- render 'icon' with 'discount', width: 12 -%}
                        {{- discount_application.title -}}
                        (-{{ discount_application.total_allocated_amount | money }})
                        {%- if section.settings.allow_discount_application and discount_application.type != '' -%}
                          <cart-discount-remove-button
                            discount-code="{{ discount_application.title | escape }}"
                            class="h-stack align-center"
                          >
                            <button type="button">{%- render 'icon' with 'close', width: 8 -%}</button>
                          </cart-discount-remove-button>
                        {%- endif -%}
                      </span>
                    {%- endfor -%}
                  </div>
                {%- endif -%}

                {%- for block in section.blocks -%}
                  {%- if block.type == '@app' -%}{%- render block -%}{%- endif -%}
                {%- endfor -%}

                <div class="bb-recap-row bb-recap-row--total">
                  <span>{{ 'cart.general.total' | t }}:</span>
                  <span>
                    {%- if _cart_belt_count > 0 -%}
                      {{- _bb_final_total | money_with_currency -}}
                    {%- elsif _bb_single_total > 0 -%}
                      {{- _bb_final_total | money_with_currency -}}
                    {%- else -%}
                      {{- cart.total_price | money_with_currency -}}
                    {%- endif -%}
                  </span>
                </div>

                <div class="delivery-widget__manual"></div>

                {%- if section.settings.show_accelerated_buttons and additional_checkout_buttons -%}
                  <div class="additional-checkout-buttons additional-checkout-buttons--vertical">
                    {{- content_for_additional_checkout_buttons -}}
                  </div>
                {%- endif -%}

                <noscript>
                  {%- assign update_button = 'cart.general.update_cart' | t -%}
                  {%- render 'button', type: 'submit', content: update_button, style: 'outline' -%}
                </noscript>

                <button type="submit" name="checkout" class="bb-checkout-btn">
                  {{ 'cart.general.checkout' | t }}
                </button>
              </div>
            </div>
          </div>

          {%- comment -%}
            ----------------------------------------------------------------------------------------------------------------
            SHIPPING ESTIMATOR
            ----------------------------------------------------------------------------------------------------------------
          {%- endcomment -%}

          {%- if section.settings.show_shipping_estimator and cart.requires_shipping -%}
            {%- render 'shipping-estimator' -%}
          {%- endif -%}
        </form>
      </div>
    </div>
  {%- endif -%}
</div>

<script>
  (function () {
    var BB_ITEMS = [
      {%- for item in cart.items -%}
        {%- assign _is_nfc        = false -%}
        {%- assign _is_extra      = false -%}
        {%- assign _is_component  = false -%}
        {%- assign _is_privileged = false -%}
        {%- assign _bundle_id     = '' -%}
        {%- assign _bc = 0 -%}
        {%- for _p in item.properties -%}
          {%- if _p.first == '_bundle_nfc'        -%}{%- assign _is_nfc        = true -%}{%- endif -%}
          {%- if _p.first == '_bundle_extra'      -%}{%- assign _is_extra      = true -%}{%- endif -%}
          {%- if _p.first == '_bundle_component'  -%}{%- assign _is_component  = true -%}{%- endif -%}
          {%- if _p.first == '_bundle_privileged' -%}{%- assign _is_privileged = true -%}{%- endif -%}
          {%- if _p.first == '_bundle_id'         -%}{%- assign _bundle_id     = _p.last -%}{%- endif -%}
          {%- if _p.first contains 'Cintura ' and _p.first contains ' - Pelle' -%}{%- assign _bc = _bc | plus: 1 -%}{%- endif -%}
        {%- endfor -%}
        { key: {{ item.key | json }}, qty: {{ item.quantity }}, belts: {{ _bc }}, isNfc: {{ _is_nfc }}, isExtra: {{ _is_extra }}, isComponent: {{ _is_component }}, isPrivileged: {{ _is_privileged }}, bundleId: {{ _bundle_id | json }} }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ];

    var hasBundleItems = BB_ITEMS.some(function (i) { return i.isNfc || i.isExtra || i.isComponent || i.isPrivileged; });
    if (!hasBundleItems) return;

    function onBundleChange(changedKey, newQty) {
      var item = BB_ITEMS.find(function (i) { return i.key === changedKey; });
      if (!item || !item.belts) return false;

      var updates = {};
      updates[changedKey] = newQty;

      /* Find all satellite items that share this bundle's _bundle_id */
      var siblings = item.bundleId
        ? BB_ITEMS.filter(function (i) { return i.key !== changedKey && i.bundleId === item.bundleId; })
        : [];

      if (newQty === 0) {
        /* Removing the bundle — zero out ALL hidden satellites across every session.
           After proceedToCheckout merges bundles into one SET-CINTURA, orphaned
           NFC/component items from earlier sessions carry different bundleIds and
           would be missed by a same-bundleId filter. */
        BB_ITEMS.forEach(function (i) {
          if (i.key !== changedKey && (i.isNfc || i.isExtra || i.isComponent || i.isPrivileged)) {
            updates[i.key] = 0;
          }
        });
      } else {
        /* Quantity change (bundle qty is always 1, but handle it defensively) */
        var delta = item.qty - newQty;
        siblings.forEach(function (s) {
          if (s.isNfc || s.isPrivileged) {
            updates[s.key] = Math.max(0, s.qty - item.belts * delta);
          } else if (s.isExtra) {
            var remainingBelts = BB_ITEMS
              .filter(function (i) { return i.belts > 0; })
              .reduce(function (sum, i) {
                var q = i.key === changedKey ? newQty : i.qty;
                return sum + i.belts * q;
              }, 0);
            updates[s.key] = Math.max(0, remainingBelts - 4);
          }
          /* _bundle_component items keep their qty — they track inventory per unit sold */
        });
      }

      fetch('/cart/update.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ updates: updates })
      }).then(function () { window.location.reload(); });
      return true;
    }

    /* Intercept remove links (/cart/change?id=...&quantity=0) */
    document.addEventListener('click', function (e) {
      var link = e.target.closest('a[href*="/cart/change"]');
      if (!link) return;
      var url = new URL(link.href);
      if (onBundleChange(url.searchParams.get('id'), parseInt(url.searchParams.get('quantity'), 10))) {
        e.preventDefault();
        e.stopImmediatePropagation();
      }
    }, { capture: true });

    /* Intercept quantity-input changes */
    document.addEventListener('change', function (e) {
      var input = e.target;
      if (!input.dataset || !input.dataset.lineKey) return;
      if (onBundleChange(input.dataset.lineKey, parseInt(input.value, 10))) {
        e.preventDefault();
        e.stopImmediatePropagation();
      }
    }, { capture: true });
  })();
</script>

<script>
  (function () {
    function removeSingleBelt(btn) {
      btn.disabled = true;
      var itemKey = btn.dataset.itemKey;
      var beltN = parseInt(btn.dataset.beltN, 10);
      var beltTotal = parseInt(btn.dataset.beltTotal, 10);
      var bundleId = btn.dataset.bundleId;
      var newBeltCount = beltTotal - 1;

      fetch('/cart.js')
        .then(function (r) { return r.json(); })
        .then(function (cart) {
          var mainItem = cart.items.find(function (i) { return i.key === itemKey; });
          if (!mainItem) { window.location.reload(); return; }

          var oldProps = mainItem.properties || {};

          /* Build updated properties: skip beltN, renumber remaining from 1 */
          var newProps = { _bundle_id: bundleId };
          var newN = 1;
          for (var i = 1; i <= beltTotal; i++) {
            if (i === beltN) continue;
            newProps['Cintura ' + newN + ' - Pelle']     = oldProps['Cintura ' + i + ' - Pelle'] || '';
            newProps['Cintura ' + newN + ' - Lunghezza'] = oldProps['Cintura ' + i + ' - Lunghezza'] || '';
            newProps['Cintura ' + newN + ' - Fibbia']    = oldProps['Cintura ' + i + ' - Fibbia'] || '';
            var img = oldProps['_cintura_' + i + '_img'];
            if (img) newProps['_cintura_' + newN + '_img'] = img;
            var sv = oldProps['_cintura_' + i + '_strap_vid'];
            if (sv) newProps['_cintura_' + newN + '_strap_vid'] = sv;
            var bv = oldProps['_cintura_' + i + '_buckle_vid'];
            if (bv) newProps['_cintura_' + newN + '_buckle_vid'] = bv;
            newN++;
          }

          /* Compute exact target quantities for component items from remaining belts.
             Using set-to-exact instead of decrement-by-1 eliminates race conditions
             when strap and buckle requests fire simultaneously against stale cart state. */
          var targetCompQtys = {};
          for (var ri = 1; ri <= newBeltCount; ri++) {
            var rsv = newProps['_cintura_' + ri + '_strap_vid'];
            var rbv = newProps['_cintura_' + ri + '_buckle_vid'];
            if (rsv) targetCompQtys[rsv] = (targetCompQtys[rsv] || 0) + 1;
            if (rbv) targetCompQtys[rbv] = (targetCompQtys[rbv] || 0) + 1;
          }
          var hasVids = Object.keys(targetCompQtys).length > 0 || newBeltCount === 0;

          var nfcItem = cart.items.find(function (i) {
            return i.properties && i.properties._bundle_id === bundleId && i.properties._bundle_nfc === '1';
          });

          var steps = [];

          if (nfcItem) {
            steps.push(fetch('/cart/change.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: nfcItem.key, quantity: Math.max(0, nfcItem.quantity - 1) })
            }));
          }

          if (hasVids) {
            cart.items.forEach(function (item) {
              if (!item.properties || item.properties._bundle_component !== '1') return;
              if (item.properties._bundle_id !== bundleId) return;
              var target = targetCompQtys[String(item.variant_id)] || 0;
              steps.push(fetch('/cart/change.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: item.key, quantity: target })
              }));
            });
          }

          return Promise.all(steps).then(function () {
            if (newBeltCount === 0) {
              return fetch('/cart/change.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: itemKey, quantity: 0 })
              });
            }
            return fetch('/cart/change.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: itemKey, quantity: 1, properties: newProps })
            });
          });
        })
        .then(function () { window.location.reload(); })
        .catch(function (e) {
          console.error('[BundleBuilder] removeSingleBelt error:', e);
          window.location.reload();
        });
    }

    document.addEventListener('click', function (e) {
      var btn = e.target.closest('.bb-remove-belt');
      if (!btn) return;
      e.preventDefault();
      e.stopImmediatePropagation();
      removeSingleBelt(btn);
    }, { capture: true });
  })();
</script>

{%- assign _cart_has_belts = false -%}
{%- for item in cart.items -%}
  {%- for p in item.properties -%}
    {%- if p.first contains 'Cintura ' and p.first contains ' - Pelle' -%}
      {%- assign _cart_has_belts = true -%}
    {%- endif -%}
  {%- endfor -%}
{%- endfor -%}

{%- if _cart_has_belts -%}
<style>
  .bb-checkout-spinner {
    display: inline-block;
    width: 14px;
    height: 14px;
    border: 2px solid currentColor;
    border-top-color: transparent;
    border-radius: 50%;
    flex-shrink: 0;
    will-change: transform;
    -webkit-animation: bb-chk-spin 0.7s linear infinite;
    animation: bb-chk-spin 0.7s linear infinite;
  }
  @-webkit-keyframes bb-chk-spin { to { -webkit-transform: rotate(360deg); transform: rotate(360deg); } }
  @keyframes bb-chk-spin { to { -webkit-transform: rotate(360deg); transform: rotate(360deg); } }
  .bb-checkout-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; }
</style>

<script>
  (function () {
    var CATALOG_URL = {{ 'bundle-builder-catalog.json' | asset_url | json }};
    var SET_KEYS = { 1: 'SET-CINTURA-SINGOLA', 2: 'SET-CINTURE-DOPPIO', 3: 'SET-CINTURE-TRIPLO', 4: 'SET-CINTURE-INFINITY' };
    var SET_EXTRA_KEY = 'SET-CINTURE-EXTRA';

    var checkoutBtn = document.querySelector('.bb-checkout-btn');
    if (!checkoutBtn) return;

    checkoutBtn.addEventListener('click', function (e) {
      e.preventDefault();
      e.stopImmediatePropagation();

      var origHTML = checkoutBtn.innerHTML;
      checkoutBtn.disabled = true;
      checkoutBtn.innerHTML = '<span class="bb-checkout-spinner"></span>' + origHTML;

      Promise.all([
        fetch(CATALOG_URL).then(function (r) { return r.json(); }),
        fetch('/cart.js').then(function (r) { return r.json(); })
      ]).then(function (res) {
        var catalog = res[0];
        var cart    = res[1];

        var allSetVids = new Set(
          Object.values(SET_KEYS).map(function (k) { return catalog[k] ? Number(catalog[k]) : null; }).filter(Boolean)
        );
        var extraVid = catalog[SET_EXTRA_KEY] ? Number(catalog[SET_EXTRA_KEY]) : 0;
        var nfcVid   = catalog['NFC-CARD']    ? Number(catalog['NFC-CARD'])    : 0;

        var totalBelts  = 0;
        var mergedProps = {};
        var beltN       = 0;
        var updates     = {};

        /* Scan cart — merge belt properties and mark stale items for removal */
        (cart.items || []).forEach(function (item) {
          var p       = item.properties || {};
          var isMain  = allSetVids.has(item.variant_id);
          var isExtra = extraVid && item.variant_id === extraVid;
          var isCard  = p._bundle_nfc === '1' || p._bundle_privileged === '1';

          if (isMain || isExtra || isCard) updates[item.key] = 0;

          if (isMain) {
            var maxSlot = 0;
            Object.keys(p).forEach(function (k) {
              var m = k.match(/^Cintura (\d+) - Pelle$/);
              if (m && p[k]) maxSlot = Math.max(maxSlot, parseInt(m[1], 10));
            });
            for (var i = 1; i <= maxSlot; i++) {
              beltN++; totalBelts++;
              ['Pelle', 'Lunghezza', 'Fibbia'].forEach(function (attr) {
                var v = p['Cintura ' + i + ' - ' + attr];
                if (v) mergedProps['Cintura ' + beltN + ' - ' + attr] = v;
              });
              var img = p['_cintura_' + i + '_img'];
              if (img) mergedProps['_cintura_' + beltN + '_img'] = img;
              var sv = p['_cintura_' + i + '_strap_vid'];
              if (sv) mergedProps['_cintura_' + beltN + '_strap_vid'] = sv;
              var bv = p['_cintura_' + i + '_buckle_vid'];
              if (bv) mergedProps['_cintura_' + beltN + '_buckle_vid'] = bv;
            }
            if (!mergedProps._bundle_id && p._bundle_id) mergedProps._bundle_id = p._bundle_id;
          }
        });

        /* Component reconciliation (strap + buckle inventory) */
        var correctComponentItems = [];
        var hasVids = false;
        for (var ci = 1; ci <= totalBelts; ci++) {
          if (mergedProps['_cintura_' + ci + '_strap_vid'] || mergedProps['_cintura_' + ci + '_buckle_vid']) {
            hasVids = true; break;
          }
        }
        if (hasVids) {
          (cart.items || []).forEach(function (item) {
            if (item.properties && item.properties._bundle_component === '1') {
              updates[item.key] = 0;
            }
          });
          var compQtys = {};
          for (var ci = 1; ci <= totalBelts; ci++) {
            var csv = mergedProps['_cintura_' + ci + '_strap_vid'];
            var cbv = mergedProps['_cintura_' + ci + '_buckle_vid'];
            if (csv) compQtys[csv] = (compQtys[csv] || 0) + 1;
            if (cbv) compQtys[cbv] = (compQtys[cbv] || 0) + 1;
          }
          Object.keys(compQtys).forEach(function (vid) {
            correctComponentItems.push({ id: Number(vid), quantity: compQtys[vid], properties: { _bundle_component: '1', _bundle_id: mergedProps._bundle_id || '' } });
          });
        }

        if (!Object.keys(updates).length || !totalBelts) {
          window.location.href = '/checkout';
          return;
        }

        /* Step 1 — zero out stale items */
        fetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ updates: updates })
        }).then(function () {
          var items = [];

          /* Correct SET variant: 1→SINGOLA  2→DOPPIO  3→TRIPLO  4+→INFINITY */
          var correctVid = catalog[SET_KEYS[Math.min(totalBelts, 4)]];
          if (correctVid) items.push({ id: Number(correctVid), quantity: 1, properties: mergedProps });

          /* Extra slots beyond 4 */
          if (totalBelts > 4 && extraVid) {
            items.push({ id: extraVid, quantity: totalBelts - 4, properties: { _bundle_extra: '1', _bundle_id: mergedProps._bundle_id || '' } });
          }

          /* Privilege/NFC card — exactly 1 per belt */
          if (nfcVid > 0) {
            items.push({ id: nfcVid, quantity: totalBelts, properties: { _bundle_nfc: '1', _bundle_id: mergedProps._bundle_id || '' } });
          }

          /* Strap + buckle components for inventory tracking */
          correctComponentItems.forEach(function (c) { items.push(c); });

          if (!items.length) { window.location.href = '/checkout'; return; }

          /* Step 2 — add correct items then redirect */
          return fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: items })
          });
        }).then(function () {
          window.location.href = '/checkout';
        }).catch(function () {
          window.location.href = '/checkout';
        });
      }).catch(function () {
        window.location.href = '/checkout';
      });
    }, { capture: true });
  })();
</script>
{%- endif -%}

